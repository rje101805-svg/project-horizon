{
  "name": "project-horizon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:server && playwright test",
    "build:pages": "tsc --noEmit && node scripts/build-pages.mjs",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "test:server": "tsx --test tests/*.test.ts",
    "build:server": "tsc --noEmit -p tsconfig.server.json",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
